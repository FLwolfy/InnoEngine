<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\native\Inno.Native.Sdl3\Inno.Native.Sdl3.csproj" PrivateAssets="compile" />
    <ProjectReference Include="..\..\..\native\Inno.Native.ImGui\Inno.Native.ImGui.csproj" PrivateAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inno.Platform\Inno.Platform.csproj" />
    <ProjectReference Include="..\Inno.Platform.Sdl3\Inno.Platform.Sdl3.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="BuiltIn\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="BuiltIn\Icons\FA-Regular-400.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="BuiltIn\Icons\FA-Solid-900.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
