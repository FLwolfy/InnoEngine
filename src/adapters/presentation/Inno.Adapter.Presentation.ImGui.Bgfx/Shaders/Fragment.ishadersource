vec3 SrgbToLinear(vec3 color)
{
    vec3 lower = color / 12.92;
    vec3 upper = pow((color + 0.055) / 1.055, vec3(2.4));
    return mix(upper, lower, step(color, vec3(0.04045)));
}

vec4 Evaluate(sampler2D image, vec2 texcoord, vec4 tint)
{
    return texture2D(image, texcoord) * vec4(SrgbToLinear(tint.rgb), tint.a);
}
