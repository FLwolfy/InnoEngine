<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <InnoAssemblyGroup>Core</InnoAssemblyGroup>
    <InnoScriptApi>Runtime</InnoScriptApi>
    <InnoScriptGlobalUsings>Inno.Assets.Loader</InnoScriptGlobalUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Inno.Core.Assemblies\Inno.Core.Assemblies.csproj" PrivateAssets="compile" />
    <ProjectReference Include="..\..\core\Inno.Core.Reflection\Inno.Core.Reflection.csproj" PrivateAssets="compile" />
    <ProjectReference Include="..\..\core\Inno.Core.Serialization\Inno.Core.Serialization.csproj" PrivateAssets="compile" />
    <ProjectReference Include="..\..\core\Inno.Core.Storage\Inno.Core.Storage.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Inno.Core.Identity\Inno.Core.Identity.csproj" />
    <ProjectReference Include="..\Inno.Assets.Core\Inno.Assets.Core.csproj" />
    <ProjectReference Include="..\Inno.Assets.File\Inno.Assets.File.csproj" />
    <ProjectReference Include="..\Inno.Assets.Types\Inno.Assets.Types.csproj" />
  </ItemGroup>

</Project>
