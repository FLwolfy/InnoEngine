<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <InnoAssemblyGroup>Core</InnoAssemblyGroup>
    <InnoScriptApi>Runtime</InnoScriptApi>
    <InnoScriptGlobalUsings>Inno.Core.Serialization;Inno.Core.Serialization.Converters</InnoScriptGlobalUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inno.Core.Reflection\Inno.Core.Reflection.csproj" PrivateAssets="compile" />
  </ItemGroup>

</Project>
