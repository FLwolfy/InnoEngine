<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InnoAssemblyGroup>Editor</InnoAssemblyGroup>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\editor\Inno.Editor.Scripting\Inno.Editor.Scripting.csproj" />
    <ProjectReference Include="..\..\src\editor\Inno.Editor.Core\Inno.Editor.Core.csproj" />
    <ProjectReference Include="..\..\src\editor\Inno.Editor.ImGui\Inno.Editor.ImGui.csproj" />
    <ProjectReference Include="..\..\src\editor\Inno.Editor.Interactions\Inno.Editor.Interactions.csproj" />
    <ProjectReference Include="..\..\src\editor\Inno.Editor.Assets\Inno.Editor.Assets.csproj" />
    <ProjectReference Include="..\..\src\editor\Inno.Editor.Scene\Inno.Editor.Scene.csproj" />
    <ProjectReference Include="..\..\src\assets\Inno.Assets.Loader\Inno.Assets.Loader.csproj" />
    <ProjectReference Include="..\..\src\assets\Inno.Assets.Types\Inno.Assets.Types.csproj" />
    <ProjectReference Include="..\..\src\core\Inno.Core.Assemblies\Inno.Core.Assemblies.csproj" />
    <ProjectReference Include="..\..\src\core\Inno.Core.Identity\Inno.Core.Identity.csproj" />
    <ProjectReference Include="..\..\src\core\Inno.Core.Serialization\Inno.Core.Serialization.csproj" />
    <ProjectReference Include="..\..\src\engine\Inno.Engine.Scene\Inno.Engine.Scene.csproj" />
    <ProjectReference Include="..\..\src\engine\Inno.Engine.Scene.Assets\Inno.Engine.Scene.Assets.csproj" />
    <ProjectReference Include="..\Inno.Editor.Scripting.TestPlugin\Inno.Editor.Scripting.TestPlugin.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="CopyScriptingTestPlugin" AfterTargets="Build">
    <ItemGroup>
      <ScriptingTestPlugin Include="..\Inno.Editor.Scripting.TestPlugin\bin\$(Configuration)\net9.0\Inno.Editor.Scripting.TestPlugin.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ScriptingTestPlugin)" DestinationFolder="$(OutDir)Plugins" />
  </Target>
</Project>
